<ctrls:CustomWindow x:Class="ClassToolkit.CountDown.CountDownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrls="clr-namespace:ClassToolkit.Core.Controls;assembly=ClassToolkit.Core"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource ContentBackground}"
        Title="倒计时">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <ctrls:TitleBar Grid.Row="0" Title="倒计时"/>

        <!-- 倒计时数字 -->
        <Grid Grid.Row="1">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center">

                <!-- 大号时间显示 -->
                <TextBlock x:Name="TimeDisplay"
                           Text="00:00:00"
                           FontFamily="Microsoft YaHei"
                           FontSize="160"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}"
                           HorizontalAlignment="Center"/>

                <!-- 暂停/继续按钮 -->
                <Button x:Name="PauseButton"
                        Content="暂停"
                        Width="140" Height="42"
                        FontFamily="Microsoft YaHei" FontSize="16"
                        Foreground="{DynamicResource TextPrimary}"
                        Background="{DynamicResource ControlBackground}"
                        BorderBrush="{DynamicResource ControlBorder}"
                        Cursor="Hand"
                        Margin="0,40,0,0"
                        HorizontalAlignment="Center"
                        Click="PauseButton_Click"/>

                <!-- 操作按钮 -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,30,0,0">
                    <Button x:Name="ResetBtn"
                            Content="重新设置"
                            Width="110" Height="36"
                            FontFamily="Microsoft YaHei" FontSize="14"
                            Foreground="{DynamicResource TextPrimary}"
                            Background="{DynamicResource ControlBackground}"
                            BorderBrush="{DynamicResource ControlBorder}"
                            Cursor="Hand"
                            Click="ResetButton_Click"/>
                    <Button x:Name="CloseBtn"
                            Content="关闭"
                            Width="90" Height="36"
                            FontFamily="Microsoft YaHei" FontSize="14"
                            Foreground="{DynamicResource TextPrimary}"
                            Background="{DynamicResource ControlBackground}"
                            BorderBrush="{DynamicResource ControlBorder}"
                            Cursor="Hand"
                            Margin="16,0,0,0"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</ctrls:CustomWindow>
