<ctrls:CustomWindow x:Class="ClassToolkit.CountDown.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ctrls="clr-namespace:ClassToolkit.Core.Controls;assembly=ClassToolkit.Core"
        xmlns:controls="clr-namespace:ClassToolkit.CountDown.Controls"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ContentBackground}"
        Title="倒计时" Width="480" Height="360"
        MinWidth="640" MinHeight="420">

    <Window.Resources>
        <!-- 统一的圆角按钮样式：重置 / 开始倒计时共用 -->
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 重写 ToolButton 样式，创建圆形按钮 -->
        <Style x:Key="RoundToolButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Height" Value="38"/>
            <!-- 重写模板 -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="22">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <ctrls:TitleBar Grid.Row="0" Title="倒计时"/>

        <!-- 主内容：轮盘顶部距离上边 25px，水平居中 -->
        <StackPanel Grid.Row="1"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    Margin="0,25,0,0">

            <!-- 轮盘区：直接铺在窗口背景上，无外框；整行都是滑动热区 -->
            <StackPanel x:Name="WheelArea"
                        Orientation="Horizontal"
                        Background="Transparent"
                        HorizontalAlignment="Center"
                        PreviewMouseLeftButtonDown="WheelArea_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="WheelArea_PreviewMouseMove"
                        PreviewMouseLeftButtonUp="WheelArea_PreviewMouseLeftButtonUp"
                        MouseWheel="WheelArea_MouseWheel"
                        LostMouseCapture="WheelArea_LostMouseCapture">

                <!-- 小时 -->
                <controls:NumberWheel x:Name="HourWheel"
                                      Minimum="0" Maximum="23"
                                      Value="0"
                                      TextBias="1"/>

                <!-- 分隔符（紧贴两侧轮盘） -->
                <TextBlock Text=":"
                           FontFamily="Microsoft YaHei" FontSize="36"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}"
                           VerticalAlignment="Center"
                           Margin="2,0,2,0">
                    <TextBlock.RenderTransform>
                        <!-- 视觉上移，与轮盘中心对齐 -->
                        <TranslateTransform Y="-5"/>
                    </TextBlock.RenderTransform>
                </TextBlock>

                <!-- 分钟 -->
                <controls:NumberWheel x:Name="MinuteWheel"
                                      Minimum="0" Maximum="59"
                                      Value="0"/>

                <!-- 分隔符（紧贴两侧轮盘） -->
                <TextBlock Text=":"
                           FontFamily="Microsoft YaHei" FontSize="36"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}"
                           VerticalAlignment="Center"
                           Margin="2,0,2,0">
                    <TextBlock.RenderTransform>
                        <!-- 视觉上移，与轮盘中心对齐 -->
                        <TranslateTransform Y="-5"/>
                    </TextBlock.RenderTransform>
                </TextBlock>

                <!-- 秒钟 -->
                <controls:NumberWheel x:Name="SecondWheel"
                                      Minimum="0" Maximum="59"
                                      Value="0"
                                      TextBias="-1"/>
            </StackPanel>

            <!-- 按钮区：紧贴轮盘下方，水平居中 -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,80,0,0">
                <Button x:Name="ResetButton"
                        Content="🔄"
                        Width="45"
                        Style="{StaticResource RoundToolButton}"
                        Click="ResetButton_Click" Height="45"/>
                <Button x:Name="StartButton"
                        Content="开始"
                        Width="110"
                        FontWeight="Bold"
                        Foreground="White"
                        Background="{DynamicResource SidebarAccent}"
                        BorderBrush="{DynamicResource SidebarAccent}"
                        Margin="80,0,0,0"
                        Style="{StaticResource ToolButton}"
                        Click="StartButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</ctrls:CustomWindow>
